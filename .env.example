# Copy to .env for local testing (never commit .env). On Vercel, set these in Project > Settings > Environment Variables.
# Neon: Dashboard > your project > Connect > copy the connection string (pooled is fine).
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require
# 32+ random characters, e.g. from: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Asked once on the admin page to create the first editor (12+ characters).
SETUP_KEY=
